		<div class="d-flex flex-column min-vh-50 justify-content-center align-items-center">
			<div class="card text-center">
				<div class="card-body">
					<h5 class="card-title">Search History</h5>
					<p class="card-text">Here, you can view all of the artists that you've previously searched and saved
						on the home page!</p>
				</div>
			</div>
		</div>
		<hr>
		<!--HTML AUDIO LIBRARY TABLE -->
		<div class="d-flex flex-column min-vh-50 justify-content-center align-items-center">
			<div class="card" style="width: 125rem;">
				<div class="card-header text-center">
					<h5>
						Your Library
					</h5>
				</div>
				<table class="card-table table table-hover table-striped">
					<thead>
						<tr>
							<th scope="col">#</th>
							<th scope="col">Artist</th>
							<th scope="col">Alibi</th>
							<th scope="col">Country</th>
							<th scope="col">Genre</th>
							<th scope="col">Label</th>
							<th scope="col">Biography</th>
						</tr>
					</thead>
					<tbody>
						<% if (Artists) { %>
							<% Artists.forEach(function(data){ %>
								<tr>
									<td><%=data.id %></td>
									<td><%=data.submission%></td>
									<td><%=data.nameAlt%></td>
									<td><%=data.country%></td>
									<td><%=data.genre%></td>
									<td><%=data.label%></td>
									<td><%=data.bio%></td>
								</tr>
							<% }); %>
						<% } %>
					</tbody>
				</table>
			</div>
		</div>
		</div>
		<%- include('../partials/footer') %>