<%- include('../partials/header') %>
	<%- include('../partials/navbar') %>
    <hr>
	<!--CARD-->
    <div class="d-flex flex-column min-vh-100 justify-content-center align-items-center">
        <!--Content-->
        <div class="card text-center" style="width: 20rem;">
            <img class="card-img-top" src="../resources/img/microphone.png" alt="A microphone png">
            <div class="card-body border-primary">
                <h2 class="card-title text-capitalize">The Audio DB API</h1>
                    <h5 class="card-subtitle mb-2 text-muted">Enter an audio to for the API to fetch and
                        return!</h5>
                    <div class="form-group" id="audioForm">
                        <input class="form-control" id="audioSelection" aria-describedby="emailHelp"
                            placeholder="My Audio Selection">
                        <small id="selectionHelp" class="form-text text-muted">Try: "Eminem".</small>
                    </div>
                    <button id="audioSubmit" type="submit" class="btn btn-primary" onclick="submitAudio()">Submit</button>
            </div>
    </div>
    <hr>
    <div class="d-flex flex-column min-vh-50 justify-content-center align-items-center">
        <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title">Search Submission Return</h5>
              <p class="card-text">This is where, after presssing submit, the page will return info grabbed from the API.</p>
              <ul>
                  <li>
                      <h4>Name</h4>
                      <p id="li1">_______</p>
                  </li>
                  <li>
                    <h4>Genre</h4>
                    <p id="li2">_______</p>
                </li>
                <li>
                    <h4>Place of Birth</h4>
                    <p id="li3">_______</p>
                </li>
                <li >
                    <h4>Short Biography</h4>
                    <p id="li4">_______</p>
                </li>
                <li>
                    <h4>Music Label</h4>
                    <p id="li5">_______</p>
                </li>
              </ul>
              <!--Modal Pop-Up Button-->
              <button id="searchSubmit" type="button" class="btn btn-primary" data-toggle="modal" data-target="#searchModal">
                  Add Search Result
              </button>
            </div>
          </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="searchModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Adding Search Result</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            </div>
            <div class="modal-body text-center">
                <p>Would you like to add: </p>
                <p id="modalSubmission"> . . . </p>
                <p>To your search history? </p>
            </div>
            <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="addSearchBtn" onclick="saveAudio()">Yes</button>
            <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
            </div>
        </div>
        </div>
    </div>
<%- include('../partials/footer') %>